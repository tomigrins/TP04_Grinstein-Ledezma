@{ 
    ViewData["Title"] = "Home";
}
<div class="conteiner">
<h1>Juego del Ahorcado</h1>

<p>@ViewBag.Tablero</p>

<h2>Palabra:</h2>


<h3>Letras Usadas:</h3>
<p>
@foreach (char l in (List<char>)ViewBag.letrasUsadas)
{
    @l @(" ")
}
</p>

<form action='@Url.Action("JugarLetra", "Home")' method="get">
    <input type="text" name="letra" maxlength="1" required />
    <input type="submit" value="Enviar" />
</form>

<form asp-action="arriesgoPalabra" method="post">
    <input type="text" name="palabra" maxlength="@ViewBag.cantLetras"/>
    <button type="submit">Arriesgar</button>
</form>
</div>
